# Cadena de conexión de PostgreSQL en la nube (ej. Supabase, Neon, Render, etc.)
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://postgres:tu_password@db.ejemplo.supabase.co:5432/postgres?sslmode=require"

# RPC de la red que vas a indexar (Anvil local o Arbitrum)
# Para Anvil local: http://127.0.0.1:8545
# Para Arbitrum One: https://arb1.arbitrum.io/rpc
RPC_URL="http://127.0.0.1:8545"

# Dirección del contrato Swapapp desplegado
SWAPAPP_CONTRACT_ADDRESS="0x0000000000000000000000000000000000000000"

# Bloque desde el cual iniciar la indexación (si es nuevo o en Anvil, normalmente bloque 0 o 1)
START_BLOCK="0"

# Intervalo de consulta del indexador en milisegundos (por defecto 2000 ms = 2 segundos)
POLL_INTERVAL_MS="2000"
